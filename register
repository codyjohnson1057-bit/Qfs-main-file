<script>
/* ============ MATRIX RAIN ============ */
const rainCanvas = document.getElementById('rain');
const rctx = rainCanvas.getContext('2d');
let cols, drops, fontSize = 16;
function sizeRain(){
  rainCanvas.width  = window.innerWidth;
  rainCanvas.height = window.innerHeight;
  cols  = Math.floor(rainCanvas.width / fontSize);
  drops = new Array(cols).fill(0).map(() => Math.random() * -100);
}
sizeRain(); window.addEventListener('resize', sizeRain);

/* Theme-aware matrix trail */
function rainTrail(){
  var dark = document.documentElement.classList.contains('dark');
  return dark ? 'rgba(2,4,3,0.12)' : 'rgba(232, 245, 240, 0.14)';
}
function rainGlyph(){
  var dark = document.documentElement.classList.contains('dark');
  if (dark) return Math.random() < 0.05 ? '#F4D874' : 'rgba(152,255,152,0.75)';
  return Math.random() < 0.05 ? '#B8860B' : 'rgba(5,150,105,0.45)';
}

function drawRain(){
  rctx.fillStyle = rainTrail();
  rctx.fillRect(0,0,rainCanvas.width,rainCanvas.height);
  rctx.font = fontSize + 'px monospace';
  for(let i=0;i<cols;i++){
    const x = i*fontSize, y = drops[i]*fontSize;
    rctx.fillStyle = rainGlyph();
    rctx.fillText(Math.random()<0.5?'0':'1', x, y);
    if(y > rainCanvas.height && Math.random()>0.975) drops[i]=0;
    drops[i]++;
  }
  requestAnimationFrame(drawRain);
}
requestAnimationFrame(drawRain);

/* ============ BURST ============ */
const burstCanvas = document.getElementById('burst');
const bctx = burstCanvas.getContext('2d');
function sizeBurst(){
  burstCanvas.width = window.innerWidth;
  burstCanvas.height = window.innerHeight;
}
sizeBurst(); window.addEventListener('resize', sizeBurst);
let particles = [];
function spawnBurst(x,y){
  for(let i=0;i<14;i++){
    const angle = (Math.PI*2*i/14)+Math.random()*.4;
    const speed = 1.5+Math.random()*3;
    particles.push({x,y,vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed,
      life:1,char:Math.random()<.5?'0':'1',size:fontSize+Math.random()*10});
  }
}
function drawBurst(){
  bctx.clearRect(0,0,burstCanvas.width,burstCanvas.height);
  particles.forEach(p=>{
    p.x+=p.vx; p.y+=p.vy; p.life-=0.018;
    bctx.globalAlpha=Math.max(p.life,0);
    bctx.fillStyle='#D4AF37';bctx.shadowColor='#98FF98';bctx.shadowBlur=12;
    bctx.font=p.size+'px monospace'; bctx.fillText(p.char,p.x,p.y);
  });
  bctx.globalAlpha=1;
  particles=particles.filter(p=>p.life>0);
  requestAnimationFrame(drawBurst);
}
requestAnimationFrame(drawBurst);
window.addEventListener('pointerdown', e=>{
  if(!e.target.closest('input,button,a,select,.referral-row,.terms-row'))
    spawnBurst(e.clientX,e.clientY);
});

/* ============ 3D TILT ============ */
const wordmark = document.getElementById('wordmark');
const regCard  = document.getElementById('reg-card');
function applyTilt(el,x,y,str){
  try{
    if(document.documentElement.classList.contains('light')||!document.documentElement.classList.contains('dark')||document.documentElement.classList.contains('ra-no-tilt')){if(el&&el.style){el.style.transform='none';el.style.removeProperty('transform');}return;}
    if(window.matchMedia&&(window.matchMedia('(hover: none)').matches||window.matchMedia('(pointer: coarse)').matches)){if(el&&el.style){el.style.transform='none';el.style.removeProperty('transform');}return;}
    if(('ontouchstart' in window)||(navigator.maxTouchPoints>0)){if(el&&el.style){el.style.transform='none';el.style.removeProperty('transform');}return;}
  }catch(e){if(el&&el.style)el.style.transform='none';return;}
  const r=el.getBoundingClientRect();
  const rx=(x-r.left)/r.width-0.5;const ry=(y-r.top)/r.height-0.5;
  el.style.transform = `rotateX(${(-ry * str).toFixed(2)}deg) rotateY(${(rx * str).toFixed(2)}deg) translateZ(6px)`;
}
function resetTilt(el){el.style.transform='';}
window.addEventListener('pointermove',e=>{
  applyTilt(wordmark,e.clientX,e.clientY,12);
  applyTilt(regCard,e.clientX,e.clientY,3);
});
window.addEventListener('pointerleave',()=>{resetTilt(wordmark);resetTilt(regCard);});

/* ============ PASSWORD TOGGLE ============ */
function makeToggle(btnId, inputId){
  const btn=document.getElementById(btnId), inp=document.getElementById(inputId);
  if (!btn || !inp) return;
  btn.addEventListener('click',()=>{
    const show=inp.type==='password';
    inp.type=show?'text':'password';
    btn.textContent=show?'◎':'◉';
  });
}
makeToggle('eye-pw','pw');
makeToggle('eye-confirm','pw-confirm');

/* ============ PASSWORD STRENGTH ============ */
const pwInput     = document.getElementById('pw');
const segs        = [1,2,3,4].map(n=>document.getElementById('seg'+n));
const strLabel    = document.getElementById('strength-label');
const reqs        = {
  len : document.getElementById('req-len'),
  low : document.getElementById('req-low'),
  upp : document.getElementById('req-upp'),
  num : document.getElementById('req-num'),
};
const colors=['','var(--strength-weak)','var(--strength-fair)','var(--strength-good)','var(--strength-strong)'];
const labels=['','WEAK','FAIR','GOOD','STRONG'];

function checkPw(val){
  const checks={
    len: val.length>=8,
    low: /[a-z]/.test(val),
    upp: /[A-Z]/.test(val),
    num: /\d/.test(val),
  };
  let score=0;
  Object.entries(checks).forEach(([k,v])=>{
    reqs[k].classList.toggle('met',v);
    if(v) score++;
  });
  const c=score>0?colors[score]:'rgba(212,175,55,.15)';
  segs.forEach((s,i)=>{
    s.style.background = i<score ? c : 'rgba(212,175,55,.15)';
  });
  strLabel.textContent=score>0?labels[score]:'';
  strLabel.style.color=c;
  return checks;
}
if (pwInput) pwInput.addEventListener('input',()=>checkPw(pwInput.value));

