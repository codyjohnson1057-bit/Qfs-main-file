/* ============ STEP INDICATOR ============ */
function updateSteps(active){
  [1,2,3].forEach(n=>{
    const node=document.getElementById('step'+n);
    node.classList.toggle('done',n<active);
    node.classList.toggle('active',n===active);
  });
  [1,2].forEach(n=>{
    document.getElementById('line'+n).classList.toggle('done',n<active);
  });
}

/* ============ FORM SUBMIT ============ */
const regForm   = document.getElementById('reg-form');
const submitBtn = document.getElementById('submitBtn');
const errMsg    = document.getElementById('err-msg');

function showErr(msg){
  errMsg.textContent='⚠ '+msg;
  errMsg.classList.add('show');
  errMsg.scrollIntoView({behavior:'smooth',block:'nearest'});
}

if (regForm) regForm.addEventListener('submit', async e => {
  e.preventDefault();
  errMsg.classList.remove('show');

  const firstName = document.getElementById('fname').value.trim();
  const lastName = document.getElementById('lname').value.trim();
  // username is optional for backend, but we capture it for future use
  const email = document.getElementById('email').value.trim();
  const phone = document.getElementById('phone').value.trim();
  const country = document.getElementById('country').value;
  const password = pwInput.value;
  const passwordConf = document.getElementById('pw-confirm').value;
  const terms = document.getElementById('terms-check').checked;

  // validation
  if(!firstName || !lastName){ return showErr('Please enter your full name.'); }
  if(!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){ return showErr('Please enter a valid email.'); }
  if(!phone){ return showErr('Phone number is required.'); }
  if(!country){ return showErr('Please select your country.'); }
  const pwChecks = checkPw(password);
  if(!Object.values(pwChecks).every(Boolean)){ return showErr('Password does not meet requirements.'); }
  if(password !== passwordConf){ return showErr('Passwords do not match.'); }
  if(!terms){ return showErr('You must accept the Terms & Conditions.'); }

  updateSteps(2);
  submitBtn.classList.add('loading');
  submitBtn.textContent = 'ENCRYPTING IDENTITY...';

  // Combine first & last name into fullName
  const fullName = firstName + ' ' + lastName;

  // Build payload matching backend expectations
  const payload = {
    fullName: fullName,
    email: email,
    phone: phone,
    country: country,
    password: password
    // referral_code can be added later if you extend the backend
  };

  try {
    // Use the ABSOLUTE backend URL
    const __api = (window.RA && RA.API_BASE) || ((location.hostname==='localhost'||location.hostname==='127.0.0.1') ? 'http://127.0.0.1:5987' : 'https://web-production-8f747.up.railway.app');
    const res = await fetch(__api + '/api/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (res.ok) {
      // Store token and user for auto-login
      if (data.token) {
        localStorage.setItem('token', data.token);
        localStorage.setItem('user', JSON.stringify(data.user));
      }
      updateSteps(3);
      // Show success overlay and redirect to dashboard after 2 seconds
      document.getElementById('success-overlay').classList.add('show');
      setTimeout(() => {
        window.location.href = 'dashboard.html';
      }, 2000);
    } else {
      throw new Error(data.error || 'Registration failed. Try again.');
    }
  } catch (err) {
    updateSteps(1);
    showErr(err.message || 'Connection failed. Try again.');
    submitBtn.classList.remove('loading');
    submitBtn.textContent = 'CREATE ACCOUNT';
  }
});

