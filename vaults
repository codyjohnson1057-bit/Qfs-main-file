<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <script>(function(){try{var t=localStorage.getItem("ra-theme");var f=null;try{f=localStorage.getItem("FinappDarkmode");}catch(x){}var mode=(t==="light"||t==="dark")?t:(f==="1"?"dark":f==="0"?"light":"light");if(mode==="light"){document.documentElement.classList.remove("dark");document.documentElement.classList.add("light");}else{document.documentElement.classList.add("dark");document.documentElement.classList.remove("light");}}catch(e){document.documentElement.classList.add("light");}})();</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Robinhood Alliance - Vaults</title>
    <link rel="stylesheet" href="/static/css/style.css">
    <link rel="stylesheet" href="/static/css/font-awesome.css">
    <link rel="stylesheet" href="/static/css/App_Global.css">
    <link rel="stylesheet" href="/static/css/glass-dashboard.css?v=1790400001">
    <script src="/static/js/jquery-3.6.0.min.js"></script>
    <script src="/static/js/ra-api.js?v=1790400001"></script>
    <style>
      .mock-card { border-radius: 1.25rem; padding: 1.25rem; margin-bottom: 1rem; }
      .pill { display:inline-block; padding: 0.2rem 0.55rem; border-radius: 999px; font-size: 0.7rem; background: rgba(16,185,129,0.18); color: #6ee7b7; }
      .progress { height: 8px; border-radius: 999px; background: rgba(255,255,255,0.08); overflow: hidden; }
      .progress > span { display:block; height:100%; background: linear-gradient(90deg,#10b981,#d4af37); }
      .btn-glass { background: rgba(16,185,129,0.2); border: 1px solid rgba(16,185,129,0.35); color: #ecfdf5; border-radius: 12px; padding: 0.55rem 1rem; cursor: pointer; }
      .btn-glass:disabled { opacity: 0.5; cursor: not-allowed; }
      .btn-glass.ghost { background: transparent; }
      html:not(.dark) .btn-glass { color: #064e3b; }
      .hist-row { display:flex; justify-content:space-between; gap:10px; padding:0.65rem 0; border-bottom:1px solid rgba(255,255,255,0.06); font-size:0.85rem; }
      .hist-row .muted { font-size:0.7rem; opacity:0.65; }
    </style>
</head>
<body class="glass-ui">
    <div class="appHeader text-light ico1">
        <div class="left">
            <a href="/dashboard.html" class="headerButton"><ion-icon name="chevron-back-outline"></ion-icon></a>
        </div>
        <div class="pageTitle"><span class="brand-title">ROBINHOOD</span></div>
        <div class="right" style="position:relative;">
            <button type="button" id="raThemeToggle" class="headerButton ra-theme-toggle" aria-label="Switch theme" title="Theme">
                <ion-icon name="sunny-outline"></ion-icon>
            </button>
        </div>
    </div>
    <div id="appCapsule" class="container" style="padding-bottom: 100px;">
        <div class="section mt-2 mb-2">
            <h2 class="title" style="font-size:1.25rem;">Vaults</h2>
            <p class="text-muted" style="font-size:0.85rem;opacity:0.75;">Goal buckets synced to your account — fund from any wallet.</p>
        </div>

        <div id="raBalanceMount"></div>
        <div id="vaultsApiNote"></div>

        <div class="wallet-card mock-card glass-panel">
            <h3 style="font-size:1rem;">Invest in a vault</h3>
            <p class="text-muted" style="font-size:0.8rem;opacity:0.75;margin-bottom:0.75rem;">Pick a goal, funding asset, and USD amount.</p>
            <label class="text-muted" style="font-size:0.75rem;">Vault</label>
            <select class="form-control mb-2" id="investVaultSelect">
              <option value="">— Select or create below —</option>
            </select>
            <label class="text-muted" style="font-size:0.75rem;">Pay from</label>
            <select class="form-control mb-2" id="investCurrencySelect">
              <option value="qfs">Loading wallets…</option>
            </select>
            <label class="text-muted" style="font-size:0.75rem;">Amount (USD)</label>
            <input class="form-control mb-2" id="investAmount" type="number" min="1" step="0.01" placeholder="Amount to invest" required>
            <button class="btn-glass" type="button" id="btnInvestVault">Invest now</button>
            <p id="investMsg" class="text-muted mt-2" style="font-size:0.8rem;"></p>
        </div>

        <div id="vaultsList"></div>

        <div class="wallet-card mock-card glass-panel">
            <h3 style="font-size:1rem;" id="vaultFormTitle">New vault</h3>
            <form id="vaultForm">
              <input type="hidden" id="vaultEditId" value="">
              <input class="form-control mb-2" id="vaultName" placeholder="Goal name (e.g. Emergency)" required>
              <input class="form-control mb-2" id="vaultTarget" type="number" min="1" step="0.01" placeholder="Target amount" required>
              <button class="btn-glass" type="submit" id="vaultSubmit">Create vault</button>
              <button class="btn-glass ghost hidden" type="button" id="vaultCancelEdit">Cancel</button>
            </form>
            <p id="vaultMsg" class="text-muted mt-2" style="font-size:0.8rem;"></p>
        </div>

        <div class="section mb-3">
            <h3 class="title" style="font-size:1rem;">History</h3>
            <div class="wallet-card mock-card" id="vaultHistory"><p class="text-muted" style="font-size:0.8rem;margin:0;">Loading…</p></div>
        </div>

    </div>

    <div class="appBottomMenu">
        <a href="/dashboard.html" class="item"><div class="col"><ion-icon name="home-outline"></ion-icon><strong>Home</strong></div></a>
        <a href="/swap.html" class="item"><div class="col"><ion-icon name="reload-outline"></ion-icon><strong>Swap</strong></div></a>
        <a href="/buy.html" class="item"><div class="col"><ion-icon name="cart-outline"></ion-icon><strong>Buy</strong></div></a>
        <a href="/cards.html" class="item"><div class="col"><ion-icon name="card-outline"></ion-icon><strong>Cards</strong></div></a>
        <a href="/payments.html" class="item"><div class="col"><ion-icon name="cash-outline"></ion-icon><strong>Payments</strong></div></a>
        <a href="/vaults.html" class="item active"><div class="col"><ion-icon name="lock-closed-outline"></ion-icon><strong>Vaults</strong></div></a>
        <a href="/profile-setting.html" class="item"><div class="col"><ion-icon name="settings-outline"></ion-icon><strong>Settings</strong></div></a>
    </div>

    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
    <script src="/static/js/lib/bootstrap.bundle.min.js"></script>
    <script>
    (function(){
      var KEY="ra-theme";
      function stored(){try{return localStorage.getItem(KEY);}catch(e){return null;}}
      function getTheme(){var t=stored();if(t==="light"||t==="dark")return t;try{var f=localStorage.getItem("FinappDarkmode");if(f==="1")return "dark";if(f==="0")return "light";}catch(e){}return "light";}
      function apply(theme,persist){
        var root=document.documentElement, body=document.body;
        if(theme==="light"){ root.classList.remove("dark"); root.classList.add("light"); if(body) body.classList.remove("dark-mode"); }
        else { root.classList.add("dark"); root.classList.remove("light"); if(body) body.classList.add("dark-mode"); }
        if(persist!==false){try{localStorage.setItem(KEY,theme);localStorage.setItem("FinappDarkmode",theme==="dark"?"1":"0");}catch(e){}}
        var btn=document.getElementById("raThemeToggle");
        if(btn){ var ic=btn.querySelector("ion-icon"); if(ic) ic.setAttribute("name", theme==="dark"?"sunny-outline":"moon-outline"); }
      }
      var btn=document.getElementById("raThemeToggle");
      if(btn) btn.addEventListener("click", function(e){ e.preventDefault(); apply(getTheme()==="dark"?"light":"dark"); });
      apply(getTheme());

      if (window.RA && RA.mountBalanceStrip) {
        RA.mountBalanceStrip(document.getElementById('raBalanceMount'), 'Portfolio (synced)');
      }

      function money(n) {
        return '$' + Number(n || 0).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 });
      }

      var vaultCache = [];
      var walletCache = {};
      var priceCache = {};

      function fillVaultSelect() {
        var sel = document.getElementById('investVaultSelect');
        if (!sel) return;
        var cur = sel.value;
        sel.innerHTML = '<option value="">— Select vault —</option>' +
          vaultCache.map(function(v){
            return '<option value="'+v.id+'">'+(v.name||'Vault')+' · '+money(v.balance)+' / '+money(v.target||0)+'</option>';
          }).join('');
        if (cur) sel.value = cur;
      }

      function fillCurrencySelect() {
        var sel = document.getElementById('investCurrencySelect');
        if (!sel) return;
        var cur = sel.value || 'qfs';
        var assets = (window.RA && RA.DASHBOARD_ASSETS) || [{key:'qfs',label:'QFS',symbol:'QFS'}];
        var opts = [];
        assets.forEach(function(a){
          var bal = Number(walletCache[a.key] || 0);
          var px = Number(priceCache[a.key] || 0);
          var usd = bal * px;
          if (bal <= 0 && a.key !== 'qfs') return;
          opts.push({key:a.key, label:a.label||a.key.toUpperCase(), bal:bal, usd:usd});
        });
        if (!opts.length) {
          opts.push({key:'qfs', label:'QFS', bal:0, usd:0});
        }
        opts.sort(function(a,b){ return b.usd - a.usd; });
        sel.innerHTML = opts.map(function(o){
          return '<option value="'+o.key+'">'+o.label+' · '+o.bal+' (≈ '+money(o.usd)+')</option>';
        }).join('');
        if (opts.some(function(o){ return o.key === cur; })) sel.value = cur;
      }

      async function loadWalletsForInvest() {
        try {
          var w = await RA.api('/api/wallets');
          walletCache = {};
          if (w.ok) {
            var list = Array.isArray(w.data) ? w.data : (w.data && w.data.wallets) || [];
            list.forEach(function(row){
              walletCache[String(row.currency||'').toLowerCase()] = Number(row.balance||0);
            });
          }
          try { priceCache = await RA.fetchAssetPrices(); } catch(e){ priceCache = {}; }
          fillCurrencySelect();
        } catch (e) {
          fillCurrencySelect();
        }
      }

      function refreshBalanceStrip() {
        if (window.RA && RA.refreshSharedBalance) {
          RA.refreshSharedBalance({ force: true }).then(function(s){
            var m=document.getElementById('raBalanceMount');
            if(m) m.innerHTML = RA.balanceStripHtml(s, 'Portfolio (synced)');
          });
        }
      }

      async function loadVaultHistory() {
        var box = document.getElementById('vaultHistory');
        var r = await RA.api('/api/transactions');
        if (!r.ok) {
          box.innerHTML = '<p class="text-muted" style="font-size:0.8rem;margin:0;">Could not load history.</p>';
          return;
        }
        var rows = Array.isArray(r.data) ? r.data : (r.data && r.data.transactions) || [];
        var filtered = rows.filter(function(t){
          var typ = String(t.type || '').toLowerCase();
          return typ.indexOf('vault') === 0 || typ.indexOf('vault_') >= 0;
        });
        if (!filtered.length) {
          box.innerHTML = '<p class="text-muted" style="font-size:0.8rem;margin:0;">No vault activity yet.</p>';
          return;
        }
        box.innerHTML = filtered.slice(0, 40).map(function(t){
          var when = t.created_at || '';
          try { when = new Date(when).toLocaleString(); } catch(e){}
          var amt = t.amount_usd != null ? money(t.amount_usd) : (t.amount != null ? String(t.amount) : '—');
          return '<div class="hist-row"><div><strong>'+(t.type||'vault')+'</strong>'+
            '<div class="muted">'+(t.description||t.currency||'')+' · '+(t.status||'')+'</div>'+
            '<div class="muted">'+when+'</div></div><div><strong>'+amt+'</strong></div></div>';
        }).join('');
      }

      document.getElementById('btnInvestVault').addEventListener('click', async function(){
        var msg = document.getElementById('investMsg');
        msg.textContent = '';
        var id = document.getElementById('investVaultSelect').value;
        var currency = document.getElementById('investCurrencySelect').value || 'qfs';
        var amount = parseFloat(document.getElementById('investAmount').value);
        if (!id) { msg.textContent = 'Select a vault first (or create one below).'; return; }
        if (!(amount > 0)) { msg.textContent = 'Enter a valid USD amount.'; return; }
        this.disabled = true;
        var r = await RA.api('/api/vaults/' + encodeURIComponent(id) + '/deposit', {
          method: 'POST',
          body: { amount: amount, currency: currency, from: currency }
        });
        this.disabled = false;
        if (r.notDeployed) { msg.textContent = 'API unavailable — deposit could not be completed.'; return; }
        if (!r.ok) {
          var detail = r.error || 'Deposit failed';
          if (r.data && r.data.balance != null && r.data.required != null) {
            detail = 'Insufficient funds in ' + String(r.data.currency||currency).toUpperCase() +
              ': have ' + r.data.balance + ', need ' + r.data.required +
              (r.data.required_usd != null ? ' (≈ '+money(r.data.required_usd)+')' : '');
          }
          msg.textContent = detail;
          return;
        }
        var debited = (r.data && r.data.debited != null) ? r.data.debited : '';
        msg.textContent = 'Invested ' + money(amount) + ' from ' + currency.toUpperCase() +
          (debited !== '' ? ' (debited ' + debited + ')' : '') + '.';
        document.getElementById('investAmount').value = '';
        refreshBalanceStrip();
        await loadWalletsForInvest();
        loadVaults();
        loadVaultHistory();
      });

      function renderVault(v) {
        var bal = Number(v.balance || 0);
        var tgt = Number(v.target || 0) || 1;
        var pct = Math.min(100, Math.round((bal / tgt) * 100));
        var pill = v.autosave ? '<span class="pill">Autosave on</span>' : '';
        return '<div class="wallet-card mock-card glass-panel" data-id="' + (v.id || '') + '">' +
          '<div style="display:flex;justify-content:space-between;align-items:baseline;">' +
          '<h3 style="font-size:1rem;margin:0;">' + (v.name || 'Vault') + '</h3>' + pill + '</div>' +
          '<div style="font-size:1.6rem;font-weight:700;margin:0.5rem 0;">' + money(bal) + '</div>' +
          '<div class="progress"><span style="width:' + pct + '%"></span></div>' +
          '<div class="text-muted mt-1" style="font-size:0.75rem;">' + money(bal) + ' of ' + money(tgt) +
          (v.autosave_amount ? ' · $' + Number(v.autosave_amount) + ' / paycheck' : '') + '</div>' +
          '<div style="display:flex;gap:8px;margin-top:0.65rem;flex-wrap:wrap;">' +
          '<button class="btn-glass" type="button" data-invest="' + (v.id || '') + '">Invest</button>' +
          '<button class="btn-glass ghost" type="button" data-edit="' + (v.id || '') + '">Edit</button></div>' +
          '</div>';
      }

      async function loadVaults() {
        var listEl = document.getElementById('vaultsList');
        var note = document.getElementById('vaultsApiNote');
        var r = await RA.api('/api/vaults');
        if (r.notDeployed) {
          listEl.innerHTML = '';
          note.innerHTML = RA.apiNotDeployedHtml('Vaults');
          return;
        }
        note.innerHTML = '';
        if (!r.ok) {
          listEl.innerHTML = '<p class="text-muted" style="font-size:0.85rem;">Could not load vaults.</p>';
          return;
        }
        var list = Array.isArray(r.data) ? r.data : (r.data && r.data.vaults) || [];
        vaultCache = list;
        fillVaultSelect();
        if (!list.length) {
          listEl.innerHTML = '<p class="text-muted" style="font-size:0.85rem;opacity:0.7;">No vaults yet — create one below.</p>';
          return;
        }
        listEl.innerHTML = list.map(renderVault).join('');
        listEl.querySelectorAll('[data-invest]').forEach(function(b){
          b.addEventListener('click', function(){
            document.getElementById('investVaultSelect').value = b.getAttribute('data-invest');
            document.getElementById('investAmount').focus();
          });
        });
        listEl.querySelectorAll('[data-edit]').forEach(function(b){
          b.addEventListener('click', function(){
            var id = b.getAttribute('data-edit');
            var v = list.find(function(x){ return String(x.id) === String(id); });
            if (!v) return;
            document.getElementById('vaultEditId').value = v.id;
            document.getElementById('vaultName').value = v.name || '';
            document.getElementById('vaultTarget').value = v.target || '';
            document.getElementById('vaultFormTitle').textContent = 'Edit vault';
            document.getElementById('vaultSubmit').textContent = 'Save changes';
            document.getElementById('vaultCancelEdit').classList.remove('hidden');
          });
        });
      }

      document.getElementById('vaultCancelEdit').addEventListener('click', function(){
        document.getElementById('vaultForm').reset();
        document.getElementById('vaultEditId').value = '';
        document.getElementById('vaultFormTitle').textContent = 'New vault';
        document.getElementById('vaultSubmit').textContent = 'Create vault';
        this.classList.add('hidden');
      });

      document.getElementById('vaultForm').addEventListener('submit', async function(e){
        e.preventDefault();
        var msg = document.getElementById('vaultMsg');
        msg.textContent = '';
        var body = {
          name: document.getElementById('vaultName').value.trim(),
          target: parseFloat(document.getElementById('vaultTarget').value)
        };
        var editId = document.getElementById('vaultEditId').value;
        var sbtn = document.getElementById('vaultSubmit');
        sbtn.disabled = true;
        var r;
        if (editId) {
          r = await RA.api('/api/vaults/' + encodeURIComponent(editId), { method: 'PATCH', body: body });
        } else {
          r = await RA.api('/api/vaults', { method: 'POST', body: body });
        }
        sbtn.disabled = false;
        if (r.notDeployed) {
          msg.textContent = 'API unavailable — vaults could not be saved right now.';
          return;
        }
        if (!r.ok) {
          msg.textContent = r.error || 'Failed to save vault';
          return;
        }
        msg.textContent = editId ? 'Vault updated.' : 'Vault created.';
        refreshBalanceStrip();
        document.getElementById('vaultForm').reset();
        document.getElementById('vaultEditId').value = '';
        document.getElementById('vaultFormTitle').textContent = 'New vault';
        document.getElementById('vaultSubmit').textContent = 'Create vault';
        document.getElementById('vaultCancelEdit').classList.add('hidden');
        loadVaults();
      });

      loadWalletsForInvest();
      loadVaults();
      loadVaultHistory();
    })();
    </script>
</body>
</html>
