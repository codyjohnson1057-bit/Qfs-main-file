<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <script>(function(){try{var t=localStorage.getItem("ra-theme");var f=null;try{f=localStorage.getItem("FinappDarkmode");}catch(x){}var mode=(t==="light"||t==="dark")?t:(f==="1"?"dark":f==="0"?"light":"light");if(mode==="light"){document.documentElement.classList.remove("dark");document.documentElement.classList.add("light");}else{document.documentElement.classList.add("dark");document.documentElement.classList.remove("light");}}catch(e){document.documentElement.classList.add("light");}})();</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Robinhood Alliance - Payments</title>
    <link rel="stylesheet" href="/static/css/style.css">
    <link rel="stylesheet" href="/static/css/font-awesome.css">
    <link rel="stylesheet" href="/static/css/App_Global.css">
    <link rel="stylesheet" href="/static/css/glass-dashboard.css?v=1790332000">
    <script src="/static/js/jquery-3.6.0.min.js"></script>
    <script src="/static/js/ra-api.js?v=1790332000"></script>
    <style>
      .mock-card { border-radius: 1.25rem; padding: 1.25rem; margin-bottom: 1rem; }
      .btn-glass { background: rgba(16,185,129,0.2); border: 1px solid rgba(16,185,129,0.35); color: #ecfdf5; border-radius: 12px; padding: 0.55rem 1rem; cursor: pointer; }
      .btn-glass:disabled { opacity: 0.5; cursor: not-allowed; }
      .pay-grid { display: grid; gap: 10px; }
      .pay-action {
        display: flex; align-items: center; gap: 12px;
        text-align: left; width: 100%;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        color: inherit; border-radius: 14px; padding: 0.75rem 0.9rem;
        transition: background 0.2s ease, border-color 0.2s ease;
        cursor: pointer;
      }
      .pay-action:hover { background: rgba(255,255,255,0.07); border-color: rgba(255,255,255,0.16); }
      .pay-action.active { border-color: rgba(16,185,129,0.55); background: rgba(16,185,129,0.12); }
      .pay-action strong { display:block; font-size: 0.9rem; font-weight: 600; }
      .pay-action span.sub { display:block; font-size: 0.7rem; opacity: 0.6; margin-top: 2px; }
      .pay-icon {
        flex-shrink: 0;
        width: 42px; height: 42px;
        display: inline-flex; align-items: center; justify-content: center;
        border-radius: 12px;
        border: 1px solid #000;
        background: transparent;
        color: #10b981;
      }
      .pay-icon ion-icon { font-size: 22px; color: #10b981; --ionicon-stroke-width: 32px; }
      .code-box {
        font-family: ui-monospace, SFMono-Regular, monospace;
        font-size: 0.8rem; letter-spacing: 0.04em;
        padding: 0.75rem; border-radius: 10px;
        background: rgba(0,0,0,0.25); border: 1px solid rgba(16,185,129,0.3);
        word-break: break-all; margin-top: 0.75rem;
      }
      .hidden { display: none !important; }
      .hist-row { display:flex; justify-content:space-between; gap:10px; padding:0.65rem 0; border-bottom:1px solid rgba(255,255,255,0.06); font-size:0.85rem; }
      .hist-row .muted { font-size:0.7rem; opacity:0.65; word-break:break-all; }
      html:not(.dark) .pay-action {
        background: rgba(255,255,255,0.55);
        border-color: rgba(16,185,129,0.2);
        color: #0f172a;
      }
      html:not(.dark) .pay-icon { border: 1px solid #000; background: rgba(255,255,255,0.7); color: #047857; }
      html:not(.dark) .pay-icon ion-icon { color: #047857; }
      html:not(.dark) .btn-glass { color: #064e3b; }
    </style>
</head>
<body class="glass-ui">
    <div class="appHeader text-light ico1">
        <div class="left">
            <a href="/dashboard.html" class="headerButton"><ion-icon name="chevron-back-outline"></ion-icon></a>
        </div>
        <div class="pageTitle"><span class="brand-title">ROBINHOOD</span></div>
        <div class="right" style="position:relative;">
            <button type="button" id="raThemeToggle" class="headerButton ra-theme-toggle" aria-label="Switch theme" title="Theme">
                <ion-icon name="sunny-outline"></ion-icon>
            </button>
        </div>
    </div>
    <div id="appCapsule" class="container" style="padding-bottom: 100px;">
        <div class="section mt-2 mb-2">
            <h2 class="title" style="font-size:1.25rem;">Payments</h2>
            <p class="text-muted" style="font-size:0.85rem;opacity:0.75;">ACH &amp; wire — contact support with your unique code to complete.</p>
        </div>

        <div id="raBalanceMount"></div>

        <div class="wallet-card mock-card glass-panel">
            <h3 style="font-size:1rem;margin-bottom:0.75rem;">Move money</h3>
            <div class="pay-grid">
                <button class="pay-action active" type="button" data-type="ach" id="btnAch">
                    <span class="pay-icon"><ion-icon name="swap-horizontal-outline"></ion-icon></span>
                    <span><strong>ACH transfer</strong><span class="sub">Bank transfer · 1–3 days</span></span>
                </button>
                <button class="pay-action" type="button" data-type="wire" id="btnWire">
                    <span class="pay-icon"><ion-icon name="flash-outline"></ion-icon></span>
                    <span><strong>Wire transfer</strong><span class="sub">Same-day cutoff 3pm ET</span></span>
                </button>
            </div>
        </div>

        <div class="wallet-card mock-card glass-panel">
            <h3 style="font-size:1rem;">New <span id="payTypeLabel">ACH</span> request</h3>
            <form id="paymentForm">
              <div class="form-group basic">
                  <label class="text-muted" style="font-size:0.75rem;">Amount</label>
                  <input class="form-control" type="number" id="payAmount" placeholder="0.00" min="0.01" step="0.01" required>
              </div>
              <div class="form-group basic mt-2">
                  <label class="text-muted" style="font-size:0.75rem;">Currency</label>
                  <select class="form-control" id="payCurrency">
                    <option value="USD" selected>USD</option>
                    <option value="EUR">EUR</option>
                    <option value="GBP">GBP</option>
                  </select>
              </div>
              <div class="form-group basic mt-2">
                  <label class="text-muted" style="font-size:0.75rem;">Note (optional)</label>
                  <input class="form-control" type="text" id="payNote" placeholder="Reference / payee">
              </div>
              <button class="btn-glass mt-3 w-100" type="submit" id="paySubmit">Submit request</button>
            </form>
            <div id="payResult" class="hidden">
              <p style="margin-top:1rem;font-size:0.9rem;"><strong>Your unique code</strong></p>
              <div class="code-box" id="payCodeDisplay"></div>
              <p class="text-muted mt-2" style="font-size:0.8rem;" id="payResultMsg">
                Contact support to complete this ACH/wire. Share the code above with support staff.
              </p>
            </div>
            <p id="payError" class="text-muted mt-2 hidden" style="font-size:0.8rem;color:#f87171;"></p>
        </div>

        <div class="section mb-3">
            <h3 class="title" style="font-size:1rem;">History</h3>
            <div class="wallet-card mock-card" id="payHistory">
              <p class="text-muted" style="font-size:0.8rem;margin:0;">Loading…</p>
            </div>
        </div>
    </div>

    <div class="appBottomMenu">
        <a href="/dashboard.html" class="item"><div class="col"><ion-icon name="home-outline"></ion-icon><strong>Home</strong></div></a>
        <a href="/swap.html" class="item"><div class="col"><ion-icon name="reload-outline"></ion-icon><strong>Swap</strong></div></a>
        <a href="/buy.html" class="item"><div class="col"><ion-icon name="cart-outline"></ion-icon><strong>Buy</strong></div></a>
        <a href="/cards.html" class="item"><div class="col"><ion-icon name="card-outline"></ion-icon><strong>Cards</strong></div></a>
        <a href="/payments.html" class="item active"><div class="col"><ion-icon name="cash-outline"></ion-icon><strong>Payments</strong></div></a>
        <a href="/vaults.html" class="item"><div class="col"><ion-icon name="lock-closed-outline"></ion-icon><strong>Vaults</strong></div></a>
        <a href="/profile-setting.html" class="item"><div class="col"><ion-icon name="settings-outline"></ion-icon><strong>Settings</strong></div></a>
    </div>
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
    <script src="/static/js/lib/bootstrap.bundle.min.js"></script>
    <script>
    (function(){
      var KEY="ra-theme";
      function stored(){try{return localStorage.getItem(KEY);}catch(e){return null;}}
      function getTheme(){var t=stored();if(t==="light"||t==="dark")return t;try{var f=localStorage.getItem("FinappDarkmode");if(f==="1")return "dark";if(f==="0")return "light";}catch(e){}return "light";}
      function apply(theme,persist){
        var root=document.documentElement, body=document.body;
        if(theme==="light"){ root.classList.remove("dark"); root.classList.add("light"); if(body) body.classList.remove("dark-mode"); }
        else { root.classList.add("dark"); root.classList.remove("light"); if(body) body.classList.add("dark-mode"); }
        if(persist!==false){try{localStorage.setItem(KEY,theme);localStorage.setItem("FinappDarkmode",theme==="dark"?"1":"0");}catch(e){}}
        var btn=document.getElementById("raThemeToggle");
        if(btn){ var ic=btn.querySelector("ion-icon"); if(ic) ic.setAttribute("name", theme==="dark"?"sunny-outline":"moon-outline"); }
      }
      var btn=document.getElementById("raThemeToggle");
      if(btn) btn.addEventListener("click", function(e){ e.preventDefault(); apply(getTheme()==="dark"?"light":"dark"); });
      apply(getTheme());

      if (window.RA && RA.mountBalanceStrip) {
        RA.mountBalanceStrip(document.getElementById('raBalanceMount'), 'Portfolio (synced)');
      }

      var payType = 'ach';
      function setType(t) {
        payType = t;
        document.getElementById('payTypeLabel').textContent = t === 'wire' ? 'Wire' : 'ACH';
        document.querySelectorAll('.pay-action[data-type]').forEach(function(el){
          el.classList.toggle('active', el.getAttribute('data-type') === t);
        });
      }
      document.getElementById('btnAch').addEventListener('click', function(){ setType('ach'); });
      document.getElementById('btnWire').addEventListener('click', function(){ setType('wire'); });

      function money(n, cur) {
        // Prefer converting USD-notional via RA; if amount is already in a crypto unit with cur, show units
        var code = (cur || '').toUpperCase();
        var crypto = {BTC:1,ETH:1,USDT:1,TRX:1,TRON:1,BNB:1,XRP:1,XLM:1,QFS:1};
        if (code && crypto[code]) {
          return Number(n||0).toLocaleString(undefined,{maximumFractionDigits:8}) + ' ' + code;
        }
        if (window.RA && typeof RA.fmtMoney === 'function') return RA.fmtMoney(n);
        return '$' + Number(n || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }

      function renderPayRow(p) {
        var code = p.code || p.id || '—';
        var amt = p.amount != null ? money(p.amount, p.currency || 'USD') : '—';
        var st = p.status || 'pending_support';
        var when = p.created_at || '';
        try { when = new Date(when).toLocaleString(); } catch(e){}
        var typ = (p.type || 'payment').toUpperCase();
        return '<div class="hist-row"><div><strong>' + typ + '</strong>' +
          '<div class="muted">' + code + ' · ' + st + '</div>' +
          '<div class="muted">' + when + '</div></div><div><strong>' + amt + '</strong></div></div>';
      }

      async function loadHistory() {
        var box = document.getElementById('payHistory');
        var r = await RA.api('/api/payments');
        if (r.ok) {
          var list = Array.isArray(r.data) ? r.data : (r.data && r.data.payments) || [];
          if (!list.length) {
            box.innerHTML = '<p class="text-muted" style="font-size:0.8rem;margin:0;">No payments yet.</p>';
            return;
          }
          box.innerHTML = list.map(renderPayRow).join('');
          return;
        }
        // Fallback: transactions filtered to payment/ach/wire
        var tx = await RA.api('/api/transactions');
        if (tx.ok) {
          var rows = Array.isArray(tx.data) ? tx.data : (tx.data && tx.data.transactions) || [];
          var filtered = rows.filter(function(t){
            var typ = String(t.type || t.kind || '').toLowerCase();
            return typ.indexOf('ach') >= 0 || typ.indexOf('wire') >= 0 || typ.indexOf('payment') >= 0;
          });
          if (!filtered.length) {
            box.innerHTML = '<p class="text-muted" style="font-size:0.8rem;margin:0;">No payments yet.</p>';
            return;
          }
          box.innerHTML = filtered.map(function(t){
            return renderPayRow({
              type: t.type,
              code: t.description || t.id,
              status: t.status,
              amount: t.amount_usd != null ? t.amount_usd : t.amount,
              currency: (t.currency || 'USD').toUpperCase(),
              created_at: t.created_at
            });
          }).join('');
          return;
        }
        box.innerHTML = '<p class="text-muted" style="font-size:0.8rem;margin:0;">Could not load payment history.</p>';
      }

      document.getElementById('paymentForm').addEventListener('submit', async function(e){
        e.preventDefault();
        var amount = parseFloat(document.getElementById('payAmount').value);
        var currency = document.getElementById('payCurrency').value;
        var note = document.getElementById('payNote').value || '';
        var errEl = document.getElementById('payError');
        var resEl = document.getElementById('payResult');
        errEl.classList.add('hidden');
        resEl.classList.add('hidden');
        if (!(amount > 0)) {
          errEl.textContent = 'Enter a valid amount.';
          errEl.classList.remove('hidden');
          return;
        }
        var code = RA.uuid();
        var sbtn = document.getElementById('paySubmit');
        sbtn.disabled = true;
        sbtn.textContent = 'Submitting…';
        var r = await RA.api('/api/payments', {
          method: 'POST',
          body: { type: payType, amount: amount, currency: currency, note: note, code: code }
        });
        sbtn.disabled = false;
        sbtn.textContent = 'Submit request';
        var displayCode = (r.data && r.data.code) || code;
        document.getElementById('payCodeDisplay').textContent = displayCode;
        var msg = document.getElementById('payResultMsg');
        if (r.notDeployed) {
          msg.textContent = 'API unavailable — your code was generated locally. Contact support to complete this ' + payType.toUpperCase() + '.';
        } else if (!r.ok) {
          msg.textContent = (r.error || 'Request failed') + ' — still share this code with support if needed.';
        } else {
          msg.textContent = 'Contact support to complete this ' + payType.toUpperCase() + '. Share the unique code above. Status: ' + ((r.data && r.data.status) || 'pending_support') + '.';
        }
        try {
          if (window.RA && RA.submitFormPayload) {
            await RA.submitFormPayload({
              form: 'payments',
              type: payType,
              amount: amount,
              currency: currency,
              note: note,
              code: displayCode,
              user_email: (function(){try{return (JSON.parse(localStorage.getItem('user')||'{}').email)||'';}catch(e){return '';}})(),
              status: (r.data && r.data.status) || (r.ok ? 'pending_support' : 'client_queued')
            });
          }
        } catch (formErr) { console.warn('formsubmit', formErr); }
        resEl.classList.remove('hidden');
        if (window.RA && RA.refreshSharedBalance) {
          RA.refreshSharedBalance().then(function(s){
            var m=document.getElementById('raBalanceMount');
            if(m) m.innerHTML = RA.balanceStripHtml(s, 'Portfolio (synced)');
          });
        }
        loadHistory();
      });

      loadHistory();
    })();
    </script>
</body>
</html>
