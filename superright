    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        window.API_BASE = (window.RA && RA.API_BASE) || 'https://web-production-8f747.up.railway.app';
        const API_BASE = window.API_BASE;
        let currentUserId = null;
        let userWallets = [];
        let userTransactions = [];

        // ========== HELPERS (also on window for onclick / early callers) ==========
        function getToken() { return localStorage.getItem('token'); }
        window.getToken = getToken;
        function getUser() { try { return JSON.parse(localStorage.getItem('user')); } catch { return null; } }
        window.getUser = getUser;
        function notify(status, msg) {
            if (typeof iziToast !== 'undefined') {
                iziToast[status]({
                    title: status.charAt(0).toUpperCase() + status.slice(1),
                    message: msg,
                    position: 'topRight',
                    backgroundColor: '#fff',
                    icon: status === 'success' ? 'fas fa-check-circle' : 'fas fa-times-circle',
                    iconColor: status === 'success' ? '#28c76f' : '#eb2222',
                    progressBarColor: status === 'success' ? '#28c76f' : '#eb2222',
                    titleColor: '#474747',
                    messageColor: '#a2a2a2',
                });
            } else { alert(msg); }
        }
        window.notify = notify;

        function isOutflow(type) {
            return ['send', 'withdrawal', 'debit'].includes((type || '').toLowerCase());
        }
        function isInflow(type) {
            return ['receive', 'deposit', 'credit'].includes((type || '').toLowerCase());
        }

        function isAdminUser(user) {
            if (!user) return false;
            if (user.is_admin === true || user.isAdmin === true) return true;
            const role = String(user.role || user.user_role || '').toLowerCase();
            return role === 'admin' || role === 'superadmin' || role === 'super_admin';
        }

        async function fetchCurrentUser() {
            try {
                const res = await fetch(API_BASE + '/api/user', {
                    headers: { 'Authorization': 'Bearer ' + getToken() }
                });
                if (!res.ok) return null;
                const data = await res.json();
                const user = data && (data.user || data);
                if (user && typeof user === 'object') {
                    try { localStorage.setItem('user', JSON.stringify(user)); } catch (e) {}
                    return user;
                }
            } catch (e) {}
            return null;
        }

        // ========== AUTH GUARD ==========
        function showAdminBanner(msg, isError) {
            let el = document.getElementById('adminAuthBanner');
            if (!el) {
                el = document.createElement('div');
                el.id = 'adminAuthBanner';
                el.style.cssText = 'margin:12px 16px;padding:12px 14px;border-radius:8px;font-size:0.9rem;';
                const cap = document.getElementById('appCapsule');
                if (cap) cap.insertBefore(el, cap.firstChild);
                else document.body.insertBefore(el, document.body.firstChild);
            }
            el.style.background = isError ? 'rgba(248,81,73,0.15)' : 'rgba(63,185,80,0.12)';
            el.style.border = '1px solid ' + (isError ? '#f85149' : '#3fb950');
            el.style.color = isError ? '#f85149' : '#3fb950';
            el.textContent = msg || '';
            el.style.display = msg ? 'block' : 'none';
        }
        window.showAdminBanner = showAdminBanner;

        (async function checkAdmin() {
            const token = getToken();
            if (!token) {
                showAdminBanner('Not signed in — redirecting to login…', true);
                setTimeout(function(){ window.location.href = '/login'; }, 600);
                return;
            }
            let user = getUser();
            let adminOk = isAdminUser(user);
            if (!adminOk) {
                user = await fetchCurrentUser();
                adminOk = isAdminUser(user);
            }
            if (!adminOk) {
                try {
                    const probe = await fetch(API_BASE + '/api/admin/users', {
                        headers: { 'Authorization': 'Bearer ' + token }
                    });
                    if (probe.status === 401 || probe.status === 403) {
                        showAdminBanner('Authenticated but not an admin (HTTP ' + probe.status + '). Set users.role = admin in Neon, then re-login.', true);
                        const tb = document.getElementById('usersTableBody');
                        if (tb) tb.innerHTML = '<tr><td colspan="8" class="text-center text-danger">Admin role required. Neon: UPDATE users SET role = \'admin\' WHERE email = \'you@…\'; then log out/in.</td></tr>';
                        return;
                    }
                    if (!probe.ok) {
                        showAdminBanner('Admin check failed (HTTP ' + probe.status + '). API is up; see table for details.', true);
                        const tb = document.getElementById('usersTableBody');
                        if (tb) tb.innerHTML = '<tr><td colspan="8" class="text-center text-danger">Admin check failed (HTTP ' + probe.status + '). Role must be admin in Neon.</td></tr>';
                        return;
                    }
                    adminOk = true; // 200 ⇒ admin routes work
                    showAdminBanner('Admin API OK (role may be missing in local user JSON).', false);
                } catch (e) {
                    showAdminBanner('Cannot reach admin API: ' + ((e && e.message) || e), true);
                    return;
                }
            } else {
                showAdminBanner('Admin session active.', false);
                setTimeout(function(){ showAdminBanner(''); }, 2500);
            }
            try { refreshUsers(); } catch (e) { console.error(e); }
            try { loadNotifications(); } catch (e) { console.error(e); }
            try { loadAuditLogs(); } catch (e) { console.error(e); }
        })();

        // ========== REFRESH USERS ==========
        async function refreshUsers() {
            try {
                const res = await fetch(`${API_BASE}/api/admin/users`, {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });
                if (!res.ok) {
                    const text = await res.text();
                    throw new Error(`HTTP ${res.status}: ${text.substring(0, 100)}`);
                }
                const users = await res.json();
                renderUsers(users);
            } catch (err) {
                const tb = document.getElementById('usersTableBody');
                if (tb) tb.innerHTML =
                    `<tr><td colspan="8" class="text-center text-danger">Error: ${err.message}</td></tr>`;
                try { notify('error', 'Users load failed: ' + err.message); } catch (e) {}
            }
        }
        window.refreshUsers = refreshUsers;

        async function toggleWalletLink(id, linked) {
            try {
                const res = await fetch(`${API_BASE}/api/admin/users/${id}/wallet-link`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${getToken()}`
                    },
                    body: JSON.stringify({ linked })
                });
                if (!res.ok) {
                    let msg = 'Failed';
                    try { const d = await res.json(); msg = d.error || d.message || msg; } catch (e) {}
                    throw new Error(msg + ' (HTTP ' + res.status + ')');
                }
                notify('success', linked ? 'Wallet marked Linked' : 'Wallet marked Unlinked');
                refreshUsers();
                refreshOpenUserDrawer();
            } catch (err) {
                notify('error', err.message);
            }
        }
        window.toggleWalletLink = toggleWalletLink;

        function renderUsers(users) {
            const tbody = document.getElementById('usersTableBody');
            if (!users || users.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="text-center">No users</td></tr>`;
                return;
            }
            let html = '';
            users.forEach(u => {
                const statusBadges = [];
                if (u.is_banned) statusBadges.push('<span class="badge badge-banned">Banned</span>');
                if (u.is_suspended) statusBadges.push('<span class="badge badge-suspended">Suspended</span>');
                if (!u.is_banned && !u.is_suspended) statusBadges.push('<span class="badge badge-active">Active</span>');
                const linkBadge = u.is_wallet_linked
                 ? '<span class="badge bg-success">Linked</span>'
                 : '<span class="badge bg-danger">Unlinked</span>';
                const verifiedBadge = u.is_verified ? '<span class="badge badge-verified">Verified</span>' :
                    '<span class="badge badge-unverified">Unverified</span>';
                const roleBadge = u.role === 'admin' ? '<span class="badge bg-primary">Admin</span>' : '';
                html += `
                    <tr class="user-row" data-id="${u.id}">
                        <td>${u.id}</td>
                        <td>${u.full_name || '-'}</td>
                        <td>${u.email || '-'}</td>
                        <td>${u.phone || '-'}</td>
                        <td>${u.country || '-'}</td>
                        <td>${statusBadges.join(' ')}</td>
                        <td>${verifiedBadge} ${roleBadge}</td>
                        <td class="action-buttons">
                            <div class="row-actions">
                            <button class="btn btn-sm btn-outline-primary" onclick="viewUser(${u.id})" title="View user"><i class="fas fa-eye"></i></button>
                            <button class="btn btn-sm btn-outline-warning" onclick="toggleBan(${u.id}, ${!u.is_banned})" title="${u.is_banned ? 'Unban' : 'Ban'}"><i class="fas fa-gavel"></i></button>
                            <button class="btn btn-sm btn-outline-secondary" onclick="toggleSuspend(${u.id}, ${!u.is_suspended})" title="${u.is_suspended ? 'Unsuspend' : 'Suspend'}"><i class="fas fa-pause"></i></button>
                            <button class="btn btn-sm btn-outline-success" onclick="toggleVerify(${u.id}, ${!u.is_verified})" title="${u.is_verified ? 'Unverify' : 'Verify'}"><i class="fas fa-check-circle"></i></button>
                            <button class="btn btn-sm btn-outline-info" onclick="toggleWalletLink(${u.id}, ${!u.is_wallet_linked})" title="${u.is_wallet_linked ? 'Unlink wallet' : 'Link wallet'}"><i class="fas fa-link"></i></button>
                            <button class="btn btn-sm btn-outline-info" onclick="openBalanceModal(${u.id})" title="Adjust balance"><i class="fas fa-coins"></i></button>
                            <button class="btn btn-sm btn-outline-secondary" onclick="impersonate(${u.id})" title="Impersonate"><i class="fas fa-user-secret"></i></button>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteUser(${u.id})" title="Delete user"><i class="fas fa-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        }

        // ========== VIEW / EDIT USER ==========
        function refreshOpenUserDrawer() {
            if (document.body.classList.contains('user-drawer-open') && currentUserId) {
                viewUser(currentUserId);
            }
        }

        function openUserDrawer() {
            const drawer = document.getElementById('userDrawer');
            const backdrop = document.getElementById('userDrawerBackdrop');
            if (!drawer) return;
            if (drawer.parentElement !== document.body) document.body.appendChild(drawer);
            if (backdrop && backdrop.parentElement !== document.body) document.body.appendChild(backdrop);
            drawer.classList.add('open');
            drawer.setAttribute('aria-hidden', 'false');
            if (backdrop) {
                backdrop.classList.add('open');
                backdrop.setAttribute('aria-hidden', 'false');
            }
            document.body.classList.add('user-drawer-open');
            requestAnimationFrame(function () {
                const foot = document.getElementById('userDrawerActions');
                if (foot) try { foot.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); } catch (e) {}
            });
        }

        function closeUserDrawer() {
            const drawer = document.getElementById('userDrawer');
            const backdrop = document.getElementById('userDrawerBackdrop');
            if (drawer) {
                drawer.classList.remove('open');
                drawer.setAttribute('aria-hidden', 'true');
            }
            if (backdrop) {
                backdrop.classList.remove('open');
                backdrop.setAttribute('aria-hidden', 'true');
            }
            document.body.classList.remove('user-drawer-open');
        }

        async function viewUser(id) {
            currentUserId = id;
            try {
                const res = await fetch(`${API_BASE}/api/admin/users/${id}`, {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });
                if (!res.ok) throw new Error('Failed to fetch user details');
                const user = await res.json();
                userWallets = user.wallets || [];
                userTransactions = user.transactions || [];
                renderUserModal(user);
                openUserDrawer();
            } catch (err) {
                notify('error', err.message);
            }
        }

        function renderUserModal(user) {
            const container = document.getElementById('userModalBody');
            const titleEl = document.getElementById('userDrawerTitle');
            const subEl = document.getElementById('userDrawerSub');
            const actionsEl = document.getElementById('userDrawerActions');
            if (titleEl) titleEl.textContent = user.full_name || user.email || ('User #' + user.id);
            if (subEl) subEl.textContent = (user.email || '-') + ' · ID ' + user.id;

            let walletsHtml = userWallets.map(w =>
                `<tr>
                    <td>${w.currency}</td>
                    <td><input type="number" step="0.00000001" class="form-control form-control-sm balance-edit" data-currency="${w.currency}" value="${w.balance}" style="width:120px;"></td>
                </tr>`
            ).join('');

            let txsHtml = userTransactions.map(tx => {
                const typeClass = isOutflow(tx.type) ? 'tx-red' : (isInflow(tx.type) ? 'tx-green' : '');
