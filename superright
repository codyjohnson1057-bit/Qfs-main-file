                return;
            }
            if (r.notDeployed) { setAdminMsg(msg, 'Vaults API missing (404)', true); if (box) box.innerHTML = ''; return; }
            if (!r.ok) { setAdminMsg(msg, r.error || ('HTTP ' + r.status), true); if (box) box.innerHTML = ''; return; }
            const list = Array.isArray(r.data) ? r.data : (r.data && r.data.vaults) || [];
            setAdminMsg(msg, list.length ? (list.length + ' vault(s) — edit balance/target and Save') : 'No vaults for this user.');
            if (!box) return;
            if (!list.length) { box.innerHTML = '<div class="text-muted p-2">No vaults</div>'; return; }
            box.innerHTML = '<table class="table table-sm align-middle"><thead><tr><th>ID</th><th>Name</th><th>Balance</th><th>Target</th><th></th></tr></thead><tbody>' +
                list.map(v => {
                    const id = v.id;
                    return `<tr data-vault-id="${id}">
                      <td>${id||''}</td>
                      <td>${(v.name||'Vault').toString().replace(/</g,'&lt;')}</td>
                      <td><input class="form-control form-control-sm" style="max-width:120px" data-v-bal value="${Number(v.balance||0)}"></td>
                      <td><input class="form-control form-control-sm" style="max-width:120px" data-v-tgt value="${v.target!=null?Number(v.target):''}"></td>
                      <td><button type="button" class="btn btn-sm btn-primary" data-save-vault="${id}">Save</button></td>
                    </tr>`;
                }).join('') +
                '</tbody></table>';
            box.querySelectorAll('[data-save-vault]').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const vid = btn.getAttribute('data-save-vault');
                    const tr = btn.closest('tr');
                    const bal = parseFloat(tr.querySelector('[data-v-bal]').value);
                    const tgtRaw = tr.querySelector('[data-v-tgt]').value;
                    const tgt = tgtRaw === '' ? null : parseFloat(tgtRaw);
                    const body = { balance: bal, target: tgt };
                    // Prefer admin-scoped PATCH; fall back to user vault PATCH (works if admin owns vault)
                    let rr = await adminApi('/api/admin/users/' + encodeURIComponent(uid) + '/vaults/' + encodeURIComponent(vid), { method: 'PATCH', body });
                    if (rr.notDeployed || rr.status === 404) {
                        rr = await adminApi('/api/vaults/' + encodeURIComponent(vid), { method: 'PATCH', body });
                    }
                    if (rr.status === 401 || rr.status === 403) {
                        setAdminMsg(msg, 'Save forbidden — admin role required', true);
                        return;
                    }
                    if (!rr.ok) {
                        setAdminMsg(msg, rr.error || ('Save failed HTTP ' + rr.status), true);
                        return;
                    }
                    setAdminMsg(msg, 'Vault #' + vid + ' updated.');
                    notify('success', 'Vault updated');
                });
            });
        }
        window.loadVaultsMainAdmin = loadVaultsMainAdmin;

        function syncHubActive(targetSel) {
            document.querySelectorAll('#adminHubBar .hub-btn').forEach(b => {
                b.classList.toggle('active', b.getAttribute('data-bs-target') === targetSel);
            });
            document.querySelectorAll('#adminTabs .nav-link').forEach(b => {
                b.classList.toggle('active', b.getAttribute('data-bs-target') === targetSel);
            });
        }

        document.getElementById('btnRefreshCardsAdmin')?.addEventListener('click', refreshCardsAdmin);
        document.getElementById('btnActivateCard')?.addEventListener('click', activateCardAdmin);
        document.getElementById('btnRejectCard')?.addEventListener('click', rejectCardAdmin);
        document.getElementById('btnLoadUserAudits')?.addEventListener('click', loadUserAudits);
        document.getElementById('userAuditFilterId')?.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') { e.preventDefault(); loadUserAudits(); }
        });
        document.getElementById('user-audits-tab')?.addEventListener('shown.bs.tab', loadUserAudits);
        document.getElementById('btnSaveCard')?.addEventListener('click', () => saveCardAdmin());
        document.getElementById('btnFreezeCard')?.addEventListener('click', () => saveCardAdmin({ frozen: true, status: 'frozen' }));
        document.getElementById('btnDeactivateCard')?.addEventListener('click', () => saveCardAdmin({ status: 'deactivated' }));
        document.getElementById('btnRefreshPaymentsAdmin')?.addEventListener('click', refreshPaymentsAdmin);
        document.getElementById('btnLoadUserVaults')?.addEventListener('click', loadUserVaultsAdmin);
        document.getElementById('btnLoadVaultsMain')?.addEventListener('click', loadVaultsMainAdmin);
        document.getElementById('btnRefreshVaultsAdmin')?.addEventListener('click', loadVaultsMainAdmin);
        document.getElementById('btnLoadSwapAudit')?.addEventListener('click', loadSwapAudit);
        document.getElementById('cards-tab')?.addEventListener('shown.bs.tab', () => { syncHubActive('#cardsAdmin'); refreshCardsAdmin(); });
        document.getElementById('payments-tab')?.addEventListener('shown.bs.tab', () => { syncHubActive('#paymentsAdmin'); refreshPaymentsAdmin(); });
        document.getElementById('vaults-tab')?.addEventListener('shown.bs.tab', () => { syncHubActive('#vaultsAdmin'); });
        document.getElementById('users-tab')?.addEventListener('shown.bs.tab', () => { syncHubActive('#users'); refreshUsers(); });
        document.getElementById('compliance-tab')?.addEventListener('shown.bs.tab', () => { loadSwapAudit(); });

        // Hub bar: ensure tabs switch + load data (Bootstrap data-bs-toggle should work; reinforce)
        document.querySelectorAll('#adminHubBar .hub-btn').forEach(btn => {
            btn.addEventListener('click', (ev) => {
                try { ev.preventDefault(); } catch (e) {}
                const target = btn.getAttribute('data-bs-target');
                const tabTrigger = document.querySelector('#adminTabs [data-bs-target="' + target + '"]');
                try {
                    if (tabTrigger && window.bootstrap && bootstrap.Tab) {
                        bootstrap.Tab.getOrCreateInstance(tabTrigger).show();
                    } else if (tabTrigger) {
                        tabTrigger.click();
                    } else {
                        // Manual pane switch if Bootstrap tab trigger missing
                        document.querySelectorAll('#adminTabs .nav-link').forEach(n => n.classList.remove('active'));
                        document.querySelectorAll('.tab-pane').forEach(p => { p.classList.remove('show','active'); });
                        const pane = document.querySelector(target);
                        if (pane) { pane.classList.add('show','active'); }
                    }
                } catch (e) { console.error('hub tab switch', e); }
                syncHubActive(target);
                if (target === '#cardsAdmin') refreshCardsAdmin();
                if (target === '#paymentsAdmin') refreshPaymentsAdmin();
                if (target === '#users') refreshUsers();
                if (target === '#vaultsAdmin') {
                    const main = document.getElementById('vaultAdminUserIdMain');
                    const side = document.getElementById('vaultAdminUserId');
                    const cardUid = document.getElementById('cardAdminUserId');
                    if (main && !main.value && cardUid && cardUid.value) main.value = cardUid.value;
                    if (main && !main.value && side && side.value) main.value = side.value;
                    if (main && main.value.trim()) loadVaultsMainAdmin();
                }
            });
        });


        // Explicit window exports for onclick= handlers (never rely on script globals alone)
        window.viewUser = viewUser;
        window.openUserDrawer = openUserDrawer;
        window.closeUserDrawer = closeUserDrawer;
        window.toggleVerify = toggleVerify;
        window.toggleBan = toggleBan;
        window.toggleSuspend = toggleSuspend;
        window.deleteUser = deleteUser;
        window.impersonate = impersonate;
        window.openBalanceModal = openBalanceModal;
        window.openCreateUser = openCreateUser;
        window.saveUserEdit = saveUserEdit;

        (function bindUserDrawerChrome() {
            const backdrop = document.getElementById('userDrawerBackdrop');
            if (backdrop) {
                backdrop.addEventListener('click', function () { closeUserDrawer(); });
            }
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && document.body.classList.contains('user-drawer-open')) {
                    closeUserDrawer();
                }
            });
        })();
        window.loadNotifications = loadNotifications;
        window.loadAuditLogs = loadAuditLogs;
        window.openSendNotification = openSendNotification;
        window.editNotification = editNotification;
        window.deleteNotification = deleteNotification;
        window.editTransaction = editTransaction;
        window.addWalletRow = addWalletRow;
        window.addTransactionRow = addTransactionRow;
        window.logout = logout;
        window.refreshCardsAdmin = refreshCardsAdmin;
        window.activateCardAdmin = activateCardAdmin;
        window.saveCardAdmin = saveCardAdmin;
        window.refreshPaymentsAdmin = refreshPaymentsAdmin;
        window.loadUserVaultsAdmin = loadUserVaultsAdmin;
        window.loadSwapAudit = loadSwapAudit;
        window.isAdminUser = isAdminUser;

        setInterval(loadAuditLogs, 120000);
    </script>

