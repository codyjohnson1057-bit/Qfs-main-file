                        <span><i class="fas fa-users me-2"></i>All Users</span>
                        <div>
                            <button class="btn btn-sm btn-success me-2" onclick="openCreateUser()"><i class="fas fa-user-plus"></i> Create User</button>
                            <button class="btn btn-sm btn-secondary" onclick="refreshUsers()"><i class="fas fa-sync-alt"></i> Refresh</button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0" id="usersTable">
                                <thead>
                                    <tr>
                                        <th>ID</th><th>Name</th><th>Email</th><th>Phone</th><th>Country</th><th>Status</th><th>Verified</th><th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="usersTableBody"><tr><td colspan="8" class="text-center">Loading...</td></tr></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>


