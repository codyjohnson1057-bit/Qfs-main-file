  function hoistOverlays() {
    ['userDrawerBackdrop', 'userDrawer', 'createUserModal', 'editTxModal'].forEach(function (id) {
      var el = document.getElementById(id);
      if (el && el.parentElement !== document.body) document.body.appendChild(el);
