                            <div class="col-md-1"><input class="form-control form-control-sm" id="cardAdminCvv" placeholder="CVV"></div>
                            <div class="col-md-1 form-check d-flex align-items-center"><input class="form-check-input" type="checkbox" id="cardAdminFeePaid" checked><label class="form-check-label ms-1 small" for="cardAdminFeePaid">Fee paid</label></div>
