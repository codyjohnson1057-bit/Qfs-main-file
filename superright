        async function loadNotifications() {
            const tbody = document.getElementById('notificationsTableBody');
            tbody.innerHTML = `<tr><td colspan="6" class="text-center">Loading...</td></tr>`;

            try {
                const res = await fetch(`${API_BASE}/api/admin/notifications`, {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });

                if (!res.ok) {
                    const text = await res.text();
                    throw new Error(`HTTP ${res.status}: ${text.substring(0, 150)}`);
                }

                const notifs = await res.json();
                const list = Array.isArray(notifs) ? notifs : (notifs.notifications || []);

                if (!list || list.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="6" class="text-center">No notifications yet</td></tr>`;
                    return;
                }

                let html = '';
                list.forEach(n => {
                    const safeTitle = (n.title || '-').replace(/'/g, "\\'").replace(/"/g, '&quot;');
                    const safeMessage = (n.message || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');
                    html += `
                        <tr>
                            <td>${n.id}</td>
                            <td>${n.user_name || n.user_id || 'All Users'}</td>
                            <td>${n.title || '-'}</td>
                            <td style="max-width:280px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${n.message || ''}</td>
                            <td>${n.created_at ? new Date(n.created_at).toLocaleString() : '-'}</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" onclick="editNotification(${n.id}, '${safeTitle}', '${safeMessage}')">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-danger" onclick="deleteNotification(${n.id})">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                });
                tbody.innerHTML = html;
            } catch (err) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center text-danger">Error: ${err.message}</td></tr>`;
            }
        }

