<body class="glass-ui">

    <!-- Admin Header -->
    <div class="appHeader">
        <div class="left">
            <a href="/dashboard.html" title="Back to Dashboard"><i class="fas fa-arrow-left"></i></a>
        </div>
        <div class="pageTitle"><i class="fas fa-crown text-warning"></i> Admin Panel</div>
        <div>
            <button class="btn btn-sm btn-secondary" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Logout</button>
        </div>
    </div>

    <div id="appCapsule" class="container-fluid">
        <!-- Tabs -->
        <div class="admin-hub-bar" id="adminHubBar">
