                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <button class="btn btn-sm btn-success" type="button" id="btnActivateCard" title="POST /api/admin/users/:id/cards/activate">Approve / Activate</button>
                            <button class="btn btn-sm btn-outline-danger" type="button" id="btnRejectCard" title="POST /api/admin/users/:id/cards/reject">Reject + refund</button>
