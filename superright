        function looksLikeMissingRoute(status, data, rawText) {
            // Auth failures are NOT "not deployed"
            if (status === 401 || status === 403) return false;
            if (status !== 404) return false;
            const text = (rawText || (typeof data === 'string' ? data : '') || '').toLowerCase();
            const err = (data && (data.error || data.message) || '').toString().toLowerCase();
            // Real missing route: HTML 404 page or express "Cannot GET/POST"
            if (text.includes('<!doctype') || text.includes('<html') || text.includes('cannot get') || text.includes('cannot post')) return true;
            if (err.includes('not found') && !err.includes('user') && !err.includes('card') && !err.includes('vault')) return true;
            // JSON 404 with no structured API error → treat as missing
            if (data == null && text) return true;
            return false;
        }

        async function adminApi(path, opts) {
            const token = localStorage.getItem('token');
            try {
                const res = await fetch(API_BASE + path, {
                    method: (opts && opts.method) || 'GET',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: opts && opts.body ? JSON.stringify(opts.body) : undefined
                });
                let rawText = '';
                let data = null;
                try {
                    rawText = await res.text();
                    data = rawText ? JSON.parse(rawText) : null;
                } catch (e) {
                    data = rawText || null;
                }
                const notDeployed = looksLikeMissingRoute(res.status, data, rawText);
                return {
                    ok: res.ok,
                    status: res.status,
                    data,
                    notDeployed,
                    error: (data && (data.error || data.message)) || (res.ok ? null : ('HTTP ' + res.status))
                };
            } catch (err) {
                // Network errors: do NOT permanently disable controls as "notDeployed"
                return {
                    ok: false,
                    status: 0,
                    data: null,
                    notDeployed: false,
                    error: (err && err.message) || 'Network error'
                };
            }
        }
        window.adminApi = adminApi;


