        // ========== SAVE USER EDITS ==========
        async function saveUserEdit() {
            const id = currentUserId;
            const name = document.getElementById('edit_name').value;
            const email = document.getElementById('edit_email').value;
            const phone = document.getElementById('edit_phone').value;
            const country = document.getElementById('edit_country').value;
            const role = document.getElementById('edit_role').value;
            const verified = document.getElementById('edit_verified').value === 'true';
            const income = parseFloat(document.getElementById('edit_income').value) || 0;
            const expenses = parseFloat(document.getElementById('edit_expenses').value) || 0;
            const is_wallet_linked = document.getElementById('edit_wallet_linked').value === 'true';

            const walletInputs = document.querySelectorAll('#walletEditBody .balance-edit');
            const walletUpdates = [];
            walletInputs.forEach(inp => {
                walletUpdates.push({
                    currency: inp.dataset.currency,
                    balance: parseFloat(inp.value) || 0
                });
            });

            try {
                const res = await fetch(`${API_BASE}/api/admin/users/${id}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${getToken()}`
                    },
                    body: JSON.stringify({
                        full_name: name,
                        email,
                        phone,
                        country,
                        role,
                        is_verified: verified,
                        income,
                        expenses
                    })
                });
                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    throw new Error(err.error || 'Update failed');
                }

                // Apply wallet balance changes
                for (const w of walletUpdates) {
                    const curKey = String(w.currency || '').trim().toLowerCase();
                    if (!curKey || curKey === 'new') continue;
                    const currWallet = userWallets.find(uw => String(uw.currency || '').toLowerCase() === curKey);
                    const prev = currWallet ? Number(currWallet.balance) : 0;
                    const diff = Number(w.balance) - prev;
                    if (Math.abs(diff) > 0.00000001) {
                        const operation = diff > 0 ? 'credit' : 'debit';
                        const amount = Math.abs(diff);
                        await fetch(`${API_BASE}/api/admin/users/${id}/balance`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': `Bearer ${getToken()}`
                            },
                            body: JSON.stringify({
                                currency: curKey,
                                amount,
                                operation,
                                description: 'Admin balance edit'
                            })
                        });
                    }
                }

                notify('success', 'User updated successfully');
                closeUserDrawer();
                refreshUsers();
            } catch (err) {
                notify('error', err.message);
            }
        }

